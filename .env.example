# ==========================================
# AI Kingdom Simulator — Environment Variables
# ==========================================

# --- BANCO DE DADOS (Supabase / PostgreSQL) ---
# Se deixado em branco, o jogo utiliza automaticamente o sistema de arquivos local /tmp
NEXT_PUBLIC_SUPABASE_URL=https://sua-url-supabase.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# --- INTELIGÊNCIA ARTIFICIAL (Opcional) ---
# Se deixado em branco, o jogo utiliza o Mock Heurístico Inteligente em português (offline/sem custos)
AI_PROVIDER=groq

# Provedor Groq Cloud (Recomendado: Llama 3.3 70B com inferência < 500ms)
GROQ_API_KEY=gsk_sua_chave_groq_aqui
GROQ_MODEL=llama-3.3-70b-versatile

# Provedor Google Gemini
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-1.5-flash

# Provedor OpenAI / OpenRouter
OPENAI_API_KEY=sua_chave_openai_aqui
OPENAI_MODEL=gpt-4o-mini
